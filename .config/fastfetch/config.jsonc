// "boxed" style, recolored 10-26 to match the midnight ribbon wallpaper (#080910-#1C1F2C, white ribbon, accent #3b6fd1)
// previous config: config-classic.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "38;2;230;233;242" },
        "padding": { "top": 7, "left": 3, "right": 6 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;111;151;227", "output": "38;2;208;212;224" },
        "bar": {
            "char": { "elapsed": "■", "total": "·" },
            "border": { "left": "[", "right": "]" },
            "color": { "elapsed": "38;2;111;151;227", "total": "38;2;60;66;88", "border": "38;2;110;117;140" },
            "width": 12
        },
        "percent": {
            "type": 3,
            "color": { "green": "38;2;111;151;227", "yellow": "38;2;111;151;227", "red": "38;2;111;151;227" }
        }
    },
    "modules": [
        { "type": "title", "format": "{#1}Hey, {#38;2;111;151;227}{user-name}" },
        "break",
        { "type": "custom", "format": "{#38;2;74;81;107}┌───────────────────────── {#38;2;111;151;227}Hardware{#38;2;74;81;107} ─────────────────────────┐" },
        { "type": "cpu",     "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}CPU    ",     "format": "{name} ({cores-physical}C / {cores-logical}T) @ {freq-max}" },
        { "type": "gpu",     "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}GPU    ",     "format": "{name} [{type}]" },
        { "type": "memory",  "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}RAM    ",     "format": "{used} / {total} {percentage-bar} {percentage}" },
        { "type": "swap",    "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}SWAP   ",    "format": "{used} / {total} {percentage-bar} {percentage}" },
        { "type": "disk",    "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}DRIVE  ",   "folders": "/", "format": "{mountpoint}  {size-used} / {size-total} {size-percentage-bar} {size-percentage}" },
        { "type": "battery", "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}BATTERY", "format": "{capacity-bar} {capacity}  {status}" },
        { "type": "custom", "format": "{#38;2;74;81;107}└────────────────────────────────────────────────────────────┘" },
        "break",
        { "type": "custom", "format": "{#38;2;74;81;107}┌───────────────────────── {#38;2;111;151;227}Session{#38;2;74;81;107} ──────────────────────────┐" },
        { "type": "users",    "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}LOGIN  ", "format": "{name} // {login-time}" },
        { "type": "wm",       "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}WM     " },
        { "type": "shell",    "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}SHELL  " },
        { "type": "terminal", "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}TERM   " },
        { "type": "custom", "format": "{#38;2;74;81;107}└────────────────────────────────────────────────────────────┘" },
        "break",
        { "type": "custom", "format": "{#38;2;74;81;107}┌────────────────────── {#38;2;111;151;227}Uptime / Date{#38;2;74;81;107} ───────────────────────┐" },
        { "type": "uptime",   "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}UPTIME " },
        { "type": "datetime", "key": "{#38;2;74;81;107}├─ {#38;2;111;151;227}DATE   ", "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}:{second-pretty}" },
        { "type": "custom", "format": "{#38;2;74;81;107}└────────────────────────────────────────────────────────────┘" },
        "break",
        {
            "type": "command", "key": " ",
            "text": "h=$(date +%H); if [ $h -lt 5 ]; then g='Still up?'; elif [ $h -lt 12 ]; then g='Good morning!'; elif [ $h -lt 18 ]; then g='Good afternoon!'; else g='Good evening!'; fi; printf '\\033[1;38;2;200;206;222m%s %s.\\033[0m' \"$g\" \"$USER\""
        },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
    ]
}
