// "boxed" style — based on the pwsh fastfetch screenshot (10-26)
// previous config: config-classic.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "38;2;245;166;194" },
        "padding": { "top": 7, "left": 3, "right": 6 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;181;211;107", "output": "97" },
        "bar": {
            "char": { "elapsed": "■", "total": "·" },
            "border": { "left": "[", "right": "]" },
            "color": { "elapsed": "38;2;181;211;107", "total": "90", "border": "37" },
            "width": 12
        },
        "percent": {
            "type": 3,
            "color": { "green": "38;2;181;211;107", "yellow": "38;2;181;211;107", "red": "38;2;181;211;107" }
        }
    },
    "modules": [
        { "type": "title", "format": "{#1}Hey, {#38;2;181;211;107}{user-name}" },
        "break",
        { "type": "custom", "format": "{#90}┌───────────────────────── {#38;2;181;211;107}Hardware{#90} ─────────────────────────┐" },
        { "type": "cpu",     "key": "{#90}├─ {#38;2;181;211;107}CPU    ",     "format": "{name} ({cores-physical}C / {cores-logical}T) @ {freq-max}" },
        { "type": "gpu",     "key": "{#90}├─ {#38;2;181;211;107}GPU    ",     "format": "{name} [{type}]" },
        { "type": "memory",  "key": "{#90}├─ {#38;2;181;211;107}RAM    ",     "format": "{used} / {total} {percentage-bar} {percentage}" },
        { "type": "swap",    "key": "{#90}├─ {#38;2;181;211;107}SWAP   ",    "format": "{used} / {total} {percentage-bar} {percentage}" },
        { "type": "disk",    "key": "{#90}├─ {#38;2;181;211;107}DRIVE  ",   "folders": "/", "format": "{mountpoint}  {size-used} / {size-total} {size-percentage-bar} {size-percentage}" },
        { "type": "battery", "key": "{#90}├─ {#38;2;181;211;107}BATTERY", "format": "{capacity-bar} {capacity}  {status}" },
        { "type": "custom", "format": "{#90}└────────────────────────────────────────────────────────────┘" },
        "break",
        { "type": "custom", "format": "{#90}┌───────────────────────── {#38;2;181;211;107}Session{#90} ──────────────────────────┐" },
        { "type": "users",    "key": "{#90}├─ {#38;2;181;211;107}LOGIN  ", "format": "{name} // {login-time}" },
        { "type": "wm",       "key": "{#90}├─ {#38;2;181;211;107}WM     " },
        { "type": "shell",    "key": "{#90}├─ {#38;2;181;211;107}SHELL  " },
        { "type": "terminal", "key": "{#90}├─ {#38;2;181;211;107}TERM   " },
        { "type": "custom", "format": "{#90}└────────────────────────────────────────────────────────────┘" },
        "break",
        { "type": "custom", "format": "{#90}┌────────────────────── {#38;2;181;211;107}Uptime / Date{#90} ───────────────────────┐" },
        { "type": "uptime",   "key": "{#90}├─ {#38;2;181;211;107}UPTIME " },
        { "type": "datetime", "key": "{#90}├─ {#38;2;181;211;107}DATE   ", "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}:{second-pretty}" },
        { "type": "custom", "format": "{#90}└────────────────────────────────────────────────────────────┘" },
        "break",
        {
            "type": "command", "key": " ",
            "text": "h=$(date +%H); if [ $h -lt 5 ]; then g='Still up?'; elif [ $h -lt 12 ]; then g='Good morning!'; elif [ $h -lt 18 ]; then g='Good afternoon!'; else g='Good evening!'; fi; printf '\\033[1;38;2;245;200;120m%s %s.\\033[0m' \"$g\" \"$USER\""
        },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
    ]
}
